---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { HeroSplit } from "@/components/marketing/hero-split";
import { ServicesGrid, type Service } from "@/components/marketing/services-grid";
import { BarbersGrid } from "@/components/marketing/barbers-grid";
import { TestimonialSimple } from "@/components/marketing/testimonial";
import { BlogSection } from "@/components/marketing/blog-section";
import { CtaSection } from "@/components/marketing/cta-section";
import type { Article } from "@/components/marketing/blog/base-components/blog-cards";

const barbers = (await getCollection("barbers")).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const barberImageByName = new Map(barbers.map((b) => [b.data.name, b.data.image]));
const formatDate = (date: Date) => date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });

const toArticle = (post: (typeof posts)[number]): Article => ({
    id: post.id,
    href: `/blog/${post.id}`,
    thumbnailUrl: post.data.image,
    title: post.data.title,
    summary: post.data.description,
    category: { name: post.data.tags[0] ?? "Blog", href: "/blog" },
    author: {
        name: post.data.author,
        href: "/#barbers",
        avatarUrl: barberImageByName.get(post.data.author) ?? "/images/hero.svg",
    },
    publishedAt: formatDate(post.data.pubDate),
    readingTime: "",
    tags: [],
});

const services: Service[] = [
    { icon: "scissors", name: "Classic Haircut", price: "$35", description: "Consultation, precision scissor or clipper cut, shampoo and style. The everyday standard, done right." },
    { icon: "star", name: "Skin Fade", price: "$38", description: "High, mid or low — blended to the skin with a razor-detailed finish and crisp edges." },
    { icon: "face", name: "Beard Trim & Shape", price: "$25", description: "Beard architecture: lines set, bulk managed, edges razor-finished, oil to close." },
    { icon: "brush", name: "Hot Towel Shave", price: "$40", description: "The full ritual — hot towels, pre-shave oil, straight razor, cold towel finish." },
    { icon: "shield", name: "Kids Cut", price: "$25", description: "Patient, unhurried cuts for the under-12s. First haircut certificates on request." },
    { icon: "diamond", name: "The Full Works", price: "$65", description: "Cut, shave, beard shape, eyebrows and a scalp massage. Ninety minutes, zero errands." },
];
---

<BaseLayout title="Iron & Oak Barber Co. — Sharp cuts. Classic craft.">
    <HeroSplit
        badge="Walk-ins welcome"
        heading="Sharp cuts. Classic craft."
        subheading="Iron & Oak is a neighborhood barber shop in Portland, OR. Four chairs, straight razors, hot towels — and a cut that still looks right three weeks later."
        primaryCta={{ label: "Book your chair", href: "#book" }}
        secondaryCta={{ label: "Our services", href: "#services" }}
        image="/images/hero.svg"
    />
    <div id="services">
        <ServicesGrid services={services} />
    </div>
    <div id="barbers">
        <BarbersGrid
            barbers={barbers.map((b) => ({
                name: b.data.name,
                role: b.data.title,
                image: b.data.image,
                bio: b.body ?? "",
            }))}
        />
    </div>
    <TestimonialSimple
        quote="I've been coming to Iron & Oak every three weeks for six years. Marco's crew set the fade standard in this town — I've never once left with a bad cut."
        authorName="Daniel Reyes"
        authorTitle="Regular since 2020"
    />
    <BlogSection posts={posts.slice(0, 3).map(toArticle)} />
    <div id="book">
        <CtaSection heading="Ready for a fresh cut?" subtext="Walk in Tue–Sat, 9:00–19:00 — or call ahead and skip the wait." action={{ label: "Call (555) 013-2026", href: "tel:+15550132026" }} />
    </div>
</BaseLayout>
